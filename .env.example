# ==============================================================================
# RUBRICA SRE AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- 1. LLM CONFIGURATION (REQUIRED) ---
# Choose your provider: Both work, pick whichever API key you have

# Option A: Direct Google AI Studio (Your current setup)
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: OpenRouter (Multi-provider access - flexible for judges)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model names for Google Gemini (use models/ prefix for direct Gemini API)
SHIELD_MODEL=models/gemini-2.5-flash
TRIAGE_MODEL=models/gemini-2.5-pro

# Note: If using OpenRouter, use google/ prefix instead:
# SHIELD_MODEL=google/gemini-2.5-flash
# TRIAGE_MODEL=google/gemini-2.5-pro

# Note: If using OpenRouter, you can also use:
# - anthropic/claude-3.5-haiku (for shield)
# - anthropic/claude-3.5-sonnet (for triage)
# - openai/gpt-4o-mini (for shield)
# - openai/gpt-4o (for triage)

# --- 2. INFRASTRUCTURE (ALREADY CONFIGURED FOR DOCKER) ---
# These match the service names in docker-compose.yml
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# Codebase to index for RAG (hybrid mode)
# - If set: index this folder (a real open-source e-commerce repo checkout)
# - If not set: fall back to ./codebase
CODEBASE_ROOT=

# --- 3. INTEGRATIONS (DEMO READY) ---
# JIRA: Used for the Action node ticket creation
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_token_here

# SLACK: For #sre-alerts notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# EMAIL: For the resolution notification to the reporter
# (If using SendGrid or similar)
SENDGRID_API_KEY=your_sendgrid_key_here

# --- 4. OBSERVABILITY (OPTIONAL BUT RECOMMENDED FOR EVALUATION) ---
# LANGSMITH: For graph tracing evidence
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=rubrica-sre

# OPIK: For metrics and evaluation evidence (optional for MVP)
OPIK_API_KEY=your_opik_key_here
OPIK_WORKSPACE=your_workspace_name

# --- 5. SYSTEM SETTINGS ---
DEBUG=True
PORT=8000
