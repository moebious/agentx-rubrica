# ==============================================================================
# RUBRICA SRE AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- 1. LLM CONFIGURATION (REQUIRED) ---
# Options: 'google' or 'openrouter'
LLM_PROVIDER=google

# If using LLM_PROVIDER=google (Recommended for Gemini 2.5 Pro)
# Get your key at: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# If using LLM_PROVIDER=openrouter
# Get your key at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: Change the model string (default is google/gemini-2.5-pro)
# MODEL_NAME=google/gemini-pro-1.5

# --- 2. INFRASTRUCTURE (ALREADY CONFIGURED FOR DOCKER) ---
# These match the service names in docker-compose.yml
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# --- 3. INTEGRATIONS (DEMO READY) ---
# JIRA: Used for the Action node ticket creation
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_token_here

# SLACK: For #sre-alerts notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# EMAIL: For the resolution notification to the reporter
# (If using SendGrid or similar)
SENDGRID_API_KEY=your_sendgrid_key_here

# --- 4. OBSERVABILITY (OPTIONAL BUT RECOMMENDED FOR EVALUATION) ---
# LANGSMITH: For graph tracing evidence
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=rubrica-sre

# OPIK: For metrics and evaluation evidence (optional for MVP)
OPIK_API_KEY=your_opik_key_here
OPIK_WORKSPACE=your_workspace_name

# --- 5. SYSTEM SETTINGS ---
DEBUG=True
PORT=8000
